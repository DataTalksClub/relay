# TLS is obtained and renewed by Caddy directly from Let's Encrypt, matching
# how the existing sandbox host serves datamailer.dtcdev.click. No ALM, no ACM
# certificate, no load balancer to pay for.
{$SITE_ADDRESS} {
	encode gzip

	# The status contract is machine-polled and already bearer-authenticated;
	# logging it at info level would drown the access log.
	log {
		output stdout
		format console
	}

	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}
}
